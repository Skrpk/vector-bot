{
  "name": "vector-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-celestial": "node scripts/copy-celestial.mjs",
    "build-art": "node scripts/build-constellation-art.mjs",
    "prepare-assets": "node scripts/copy-celestial.mjs && node scripts/build-constellation-art.mjs",
    "postinstall": "npm run prepare-assets",
    "predev": "npm run prepare-assets",
    "dev": "next dev",
    "prebuild": "npm run prepare-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "d3-celestial": "^0.7.35",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "typescript": "^5"
  }
}
