# Environment variables for vector-bot (star-map Telegram Mini App)
#
# Milestone 1 needs NONE of these — the entire render path is client-side.
# These are placeholders for Milestone 2. Copy to `.env.local` when implementing.
# Never commit real secrets; `.env*` (except this file) is gitignored.

# Telegram bot token — used server-side to validate initData HMAC, to send the
# generated image into the user's chat (`/api/send-to-chat`, since a browser
# download is blocked inside Telegram's webview), and for the channel-membership
# gate (getChatMember). Required for the send-to-chat feature.
TELEGRAM_BOT_TOKEN=

# HTTPS URL of the deployed Mini App — used by the bot's /start message as the
# "Generate a Sky Map" web_app button target. Local: your tunnel URL; prod: the
# Vercel URL. Required for the /start button flow (`/api/telegram/webhook`).
TELEGRAM_WEBAPP_URL=

# Secret token verifying that webhook calls really come from Telegram. Set the
# SAME value here and in the `secret_token` you pass to setWebhook. Unset ->
# the webhook accepts unverified calls (fine locally; SET it in production).
TELEGRAM_WEBHOOK_SECRET=

# Channel-subscription gate: to send the image, the user must be subscribed to
# this channel. The bot must be an ADMIN of it so getChatMember is allowed.
# Accepts a public `@username` or a numeric `-100…` id. Leave UNSET to disable
# the gate (images then send without a subscription check).
TELEGRAM_CHANNEL_ID=-1003819808393

# Public link shown to users who aren't subscribed (opened from the "Subscribe"
# prompt). Optional when TELEGRAM_CHANNEL_ID is a public `@username` (the link
# is derived); required when the channel id is numeric / private.
TELEGRAM_CHANNEL_URL=https://t.me/vector_space2035

# TODO(milestone-2): public @channel the Mini App gates HD export behind.
NEXT_PUBLIC_TELEGRAM_CHANNEL=@vector_2049_bot

# Geocoding (Milestone 1.5): Open-Meteo (primary) needs no key. Nominatim
# (fallback) requires an identifying User-Agent per its usage policy — set a
# contact string here (optional; a sensible default is used if unset).
NOMINATIM_USER_AGENT=vector-bot-starmap/1.0 (you@example.com)

# Postgres connection. Stores users + per-download metadata (no images) and the
# NASA APOD subscription flag.
#   Local (docker compose):  postgres://vector:vector@localhost:5432/vector
#   Vercel (prod):           the pooled Neon connection string from the Vercel
#                            Postgres integration.
# Apply the schema with `npm run db:migrate`. Unset -> download logging is
# skipped (the app still works).
DATABASE_URL=postgres://vector:vector@localhost:5432/vector

# NASA APOD (daily photo broadcast). Get a free key at https://api.nasa.gov/ —
# DEMO_KEY works but is rate-limited (~50/day). We call NASA once a day, so
# either is fine; a real key is safer. Unset -> DEMO_KEY.
NASA_API_KEY=

# Protects the daily cron route (/api/cron/apod). On Vercel, set this and Vercel
# Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`. Unset ->
# the route is unauthenticated (fine locally; DO set it in production).
CRON_SECRET=

# OpenAI — used once a day (in the APOD cron) to rewrite the NASA description into
# an engaging Ukrainian blurb. Unset -> the English original is sent instead.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini).
OPENAI_MODEL=
