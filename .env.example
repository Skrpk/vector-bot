# Environment variables for vector-bot (star-map Telegram Mini App)
#
# Milestone 1 needs NONE of these — the entire render path is client-side.
# These are placeholders for Milestone 2. Copy to `.env.local` when implementing.
# Never commit real secrets; `.env*` (except this file) is gitignored.

# Telegram bot token — used server-side to validate initData HMAC and to send
# the generated image into the user's chat (`/api/send-to-chat`), since a
# browser download is blocked inside Telegram's webview. Required for the
# send-to-chat feature. TODO(milestone-2): also getChatMember (channel gate).
TELEGRAM_BOT_TOKEN=

# TODO(milestone-2): public @channel the Mini App gates HD export behind.
NEXT_PUBLIC_TELEGRAM_CHANNEL=@vector_2049_bot

# Geocoding (Milestone 1.5): Open-Meteo (primary) needs no key. Nominatim
# (fallback) requires an identifying User-Agent per its usage policy — set a
# contact string here (optional; a sensible default is used if unset).
NOMINATIM_USER_AGENT=vector-bot-starmap/1.0 (you@example.com)

# TODO(milestone-2): database connection (attribution logging / HD render jobs).
DATABASE_URL=
